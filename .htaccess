# Habilitar motor de reescritura
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir index.html a index.php de forma transparente
    RewriteRule ^index\.html$ index.php [L,QSA]

    # Redirigir blog.html a blog.php de forma transparente
    RewriteRule ^blog\.html$ blog.php [L,QSA]

    # Redirigir galeria.html a galeria.php de forma transparente
    RewriteRule ^galeria\.html$ galeria.php [L,QSA]

    # Redirigir resenas / reviews de forma transparente
    RewriteRule ^(resenas|reviews)(\.html)?$ resenas.php [L,QSA]

    # Redirigir posts antiguos a la nueva plantilla dinámica
    RewriteRule ^post1\.html$ post.php?slug=la-observacion-de-aves-una-actividad-fascinante [L,QSA]
    RewriteRule ^post2\.html$ post.php?slug=puno-remo-parado-en-tabla-el-nuevo-deporte-del-titicaca [L,QSA]
    RewriteRule ^post3\.html$ post.php?slug=misticismo-en-peru [L,QSA]

    # Soporte para URLs amigables /post/nombre-del-slug
    RewriteRule ^post/([a-zA-Z0-9_-]+)/?$ post.php?slug=$1 [L,QSA]
</IfModule>

# Proteger archivos de datos JSON para que nadie pueda descargarlos directamente por URL
<FilesMatch "\.json$">
    Order allow,deny
    Deny from all
</FilesMatch>
